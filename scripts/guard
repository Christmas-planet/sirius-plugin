#!/usr/bin/env python3
"""PreToolUse guard for Sirius. A supplementary layer only.

A hook does not block when it times out, and it cannot see the GitHub API called
from another process. The real merge gate is sirius-merge's own check of an
independent reviewer model's verdict, CI, and base. This hook catches the common
direct paths so a mistake fails loudly.

Exit 2 blocks the tool call and shows stderr to Claude. Writes to the gate
settings get permissionDecision "ask", so a person approves each one; with no
person present (claude -p) the write is refused.
"""

import json
import os
import re
import sys
from pathlib import Path

SIRIUS = Path(os.environ.get("SIRIUS_HOME", Path.home() / ".sirius")).expanduser()
PROTECTED = [SIRIUS / "config.yaml", SIRIUS / "repos", SIRIUS / "workspaces"]

BASH_RULES = [
    (re.compile(r"\bgh\s+pr\s+merge\b"),
     "Merge only through sirius-merge (the /sirius:merge skill)."),
    (re.compile(r"\bgh\s+api\b.*\bpulls/\d+/merge\b"),
     "Merge only through sirius-merge (the /sirius:merge skill)."),
    (re.compile(r"\bgh\s+api\b.*\bmergePullRequest\b"),
     "Merge only through sirius-merge (the /sirius:merge skill)."),
    (re.compile(r"--admin\b"),
     "Admin bypass of branch protection is not allowed."),
    (re.compile(r"\bgit\s+push\b.*(--force\b|-f\b|--force-with-lease\b|\s\+\S)"),
     "Force-push is not allowed from Sirius."),
    (re.compile(r"\bgh\s+api\b(?=.*\b(rulesets|branches/\S+/protection)\b)"
                r"(?=.*(-X|--method)[= ]*['\"]?(PUT|POST|PATCH|DELETE)\b)", re.IGNORECASE),
     "Changing branch protection or rulesets is the operator's job."),
    (re.compile(r"\bgh\s+api\b.*\btitle=['\"]?\[(implement|merge)\]"),
     "Set [implement] and [merge] title prefixes with gh issue/pr edit -R owner/repo, not the API."),
]
TITLE_FLAG = re.compile(r"(?:--title|-t)(?:=|\s+)(?:'([^']*)'|\"([^\"]*)\"|(\S+))")
REPO_FLAG = re.compile(r"(?:--repo|-R)(?:=|\s+)['\"]?([\w.-]+/[\w.-]+)")
# Each gate's title prefix and the (section, key) path into a resolved `sirius-config repo` result.
GATED = {"issue": ("[implement]", ("implement", "gate")), "pr": ("[merge]", ("merge", "mode"))}


def repo_config(repo):
    """Effective resolved settings for repo, or None. Reads ~/.sirius through sirius-config."""
    import importlib.machinery
    import importlib.util
    path = Path(__file__).resolve().parent.parent / "bin" / "sirius-config"
    loader = importlib.machinery.SourceFileLoader("sirius_config", str(path))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    try:
        _, repos, errors = module.load_all()
    except module.ConfigError:
        return None
    if errors:
        return None
    return next((r for r in repos if r["repo"] == repo.lower()), None)


def check_title_prefix(cmd):
    """[implement] on an Issue and [merge] on a PR are a person's go-ahead unless the
    repository's own config is set to auto for that gate."""
    m = re.search(r"\bgh\s+(issue|pr)\s+(create|edit)\b", cmd)
    if not m:
        return
    prefix, (section, key) = GATED[m.group(1)]
    titles = [next(g for g in t.groups() if g is not None) for t in TITLE_FLAG.finditer(cmd)]
    if not any(t.lstrip().startswith(prefix) for t in titles):
        return
    repo = REPO_FLAG.search(cmd)
    if not repo:
        block(f"Pass -R owner/repo when setting {prefix}, so the repo's {section}.{key} can be checked.")
    cfg = repo_config(repo.group(1))
    if not cfg or cfg[section][key] != "auto":
        block(f"Only a person adds {prefix} in {repo.group(1)} ({section}.{key} is not auto).")


def protected(path_str):
    try:
        path = Path(path_str).expanduser().resolve()
    except (OSError, RuntimeError):
        return False
    for p in PROTECTED:
        p = p.resolve()
        if path == p or p in path.parents:
            return True
    return False


def block(reason):
    print(f"sirius guard: {reason}", file=sys.stderr)
    sys.exit(2)


def main():
    try:
        event = json.load(sys.stdin)
    except ValueError:
        return 0
    tool = event.get("tool_name", "")
    args = event.get("tool_input") or {}
    if tool == "Bash":
        home = str(Path.home())
        cmd = args.get("command", "")
        cmd = re.sub(r"\$\{HOME\}|\$HOME|(?<![\w/])~(?=/)", home, cmd)
        check_title_prefix(cmd)
        for pattern, reason in BASH_RULES:
            if pattern.search(cmd):
                block(reason)
        for p in PROTECTED:
            if str(p) in cmd and re.search(r"(>|\btee\b|\bsed\s+-i|\bmv\b|\bcp\b|\brm\b|\btruncate\b)", cmd):
                block("Write Sirius settings with the Write or Edit tool so the user approves "
                      "the change; shell writes to them are refused.")
    elif tool in {"Edit", "Write", "MultiEdit", "NotebookEdit"}:
        if protected(args.get("file_path") or args.get("notebook_path") or ""):
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "ask",
                "permissionDecisionReason": "Sirius のゲート設定の変更です。内容を確認して承認してください。",
            }}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
