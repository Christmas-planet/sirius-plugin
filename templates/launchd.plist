<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.sirius.tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-l</string>
    <string>__HOME__/.sirius/bin/sirius-tick</string>
  </array>
  <key>StartInterval</key><integer>__INTERVAL_SECONDS__</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__HOME__/.sirius/logs/tick/launchd.out</string>
  <key>StandardErrorPath</key><string>__HOME__/.sirius/logs/tick/launchd.err</string>
</dict>
</plist>
