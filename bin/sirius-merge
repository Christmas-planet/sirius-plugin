#!/usr/bin/env python3
"""PRをマージする唯一の入口。

merge: manual のPRは、人がタイトル先頭に [merge] を付けたときだけ、
merge: auto のPRは、レビュー用アカウントの判定と承認がそろったときだけ squash マージする。

  sirius-merge check   <owner/repo> <pr>               条件を1つずつ表示する。書き込みはしない。
  sirius-merge merge   <owner/repo> <pr>               条件がすべてそろったときだけマージする。
  sirius-merge verdict <owner/repo> <pr> <lanes.json>  検証結果を判定コメントとしてPRへ投稿する。

規則は ~/.sirius/config.yaml と ~/.sirius/repos/<owner>__<repo>.yaml（sirius-config で解決）、
停止スイッチは ~/.sirius/STOP、記録は ~/.sirius/logs/merges.tsv。

判定は GitHub アカウントではなくモデル名で区別する。config.yaml の implementer と
reviewer（または対象リポジトリの review.reviewer）が別モデルであることを sirius-config が
要求し、判定コメントの verifier_models が実装した author_models と重ならないことを
このスクリプトが確かめる。GitHub 側の承認必須ルールセットは前提にしない
（同一アカウントは自分の PR を Approve できないため）: ゲートは判定コメントと
このスクリプト自身の検証だけにある。
"""

from __future__ import annotations

import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any
from urllib.parse import quote

SIRIUS = Path(os.environ.get("SIRIUS_HOME", Path.home() / ".sirius"))
STOP_PATH = SIRIUS / "STOP"
LOG_PATH = SIRIUS / "logs" / "merges.tsv"
MARKER = "<!-- sirius-verdict "
LANES = {
    "gates": "ゲートの再実行",
    "live": "実画面での確認",
    "audit": "差分と証跡の監査",
    "regression": "trunkとの比較",
}
PASSING = {"PASS", "PASS+NOTES"}
GREEN = {"success", "neutral", "skipped"}
TRAILER = re.compile(r"^Co-Authored-By:\s*(.+?)\s*<[^>]*>\s*$", re.IGNORECASE | re.MULTILINE)
DEPLOY_WAIT_SECONDS = 45 * 60

Check = tuple[str, bool, str]


class Refused(Exception):
    pass


def gh(*args: str, stdin: str | None = None) -> str:
    result = subprocess.run(["gh", *args], capture_output=True, text=True, input=stdin)
    if result.returncode != 0:
        lines = (result.stderr or result.stdout).strip().splitlines()
        raise Refused(f"gh {' '.join(args[:2])}: {lines[-1] if lines else result.returncode}")
    return result.stdout


def api(path: str) -> Any:
    return json.loads(gh("api", path))


def api_items(path: str, jq: str = ".[]") -> list[Any]:
    return [json.loads(line) for line in gh("api", "--paginate", path, "--jq", jq).splitlines() if line]


def _config_module() -> Any:
    path = Path(__file__).resolve().with_name("sirius-config")
    loader = importlib.machinery.SourceFileLoader("sirius_config", str(path))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def load_policy(repo: str) -> tuple[dict[str, Any], dict[str, Any] | None]:
    """Return (global config, effective repo config) for repo. Config errors refuse the merge."""
    config = _config_module()
    try:
        glob, repos, errors = config.load_all()
    except config.ConfigError as error:
        raise Refused(str(error))
    if errors:
        raise Refused("設定にエラーがある: " + " / ".join(errors))
    found = next((r for r in repos if r["repo"] == repo.lower()), None) if repo else None
    return glob, found


def implementer_login() -> str:
    return api("user")["login"]


def model_id(name: str) -> str:
    return re.sub(r"[\s.]+", "-", name.strip().lower())


def author_models(commits: list[dict[str, Any]]) -> set[str]:
    names = (name for commit in commits for name in TRAILER.findall(commit["commit"]["message"]))
    return {model_id(name) for name in names if re.search(r"claude|codex|gpt|gemini", name, re.IGNORECASE)}


def overlapping(verifiers: set[str], authors: set[str]) -> list[str]:
    return sorted({v for v in verifiers for a in authors if v == a or v.startswith(a + "-") or a.startswith(v + "-")})


def pull_request(repo: str, number: int) -> dict[str, Any]:
    for _ in range(6):
        pr = api(f"repos/{repo}/pulls/{number}")
        if pr["state"] != "open" or pr["mergeable"] is not None:
            return pr
        time.sleep(2)
    return pr


def branch_tip(repo: str, branch: str) -> str:
    return api(f"repos/{repo}/branches/{quote(branch, safe='')}")["commit"]["sha"]


def has_workflows(repo: str, ref: str) -> bool:
    result = subprocess.run(["gh", "api", f"repos/{repo}/contents/.github/workflows?ref={ref}"], capture_output=True, text=True)
    if result.returncode == 0:
        return True
    if "HTTP 404" in result.stderr:
        return False
    raise Refused(f"ワークフローの有無を確かめられない: {result.stderr.strip()[:200]}")


def patch_id(repo: str, number: int, files: list[dict[str, Any]]) -> str:
    diff = gh("pr", "diff", str(number), "-R", repo)
    ids = subprocess.run(["git", "patch-id", "--stable"], input=diff, capture_output=True, text=True, check=True).stdout.split()
    text_part = ids[0] if ids else "none"
    opaque = sorted(f"{f['filename']} {f.get('sha')}" for f in files if "patch" not in f)
    if not opaque:
        return text_part
    return f"{text_part}+{hashlib.sha256(chr(10).join(opaque).encode()).hexdigest()[:16]}"


def parse_marker(body: str) -> dict[str, Any] | None:
    start = body.index(MARKER) + len(MARKER)
    end = body.find(" -->", start)
    try:
        payload = json.loads(body[start:end])
    except json.JSONDecodeError:
        return None
    return payload if isinstance(payload, dict) else None


def latest_verdict(repo: str, number: int, head: str, tip: str) -> dict[str, Any] | None:
    """The newest verdict comment for exactly this head on exactly this base tip.

    A verdict for an older head or base is never reused, even with an identical patch-id:
    a rebase changes what the change runs against, so it has to be verified again.
    verdict_problems() is what actually enforces that the verifying model differs from
    the implementing one; the account that posted the comment is not the trust boundary.
    """
    found = None
    for comment in api_items(f"repos/{repo}/issues/{number}/comments?per_page=100"):
        if MARKER not in comment["body"]:
            continue
        payload = parse_marker(comment["body"])
        if payload and payload.get("head_sha") == head and payload.get("base_sha") == tip:
            found = {**payload, "url": comment["html_url"]}
    return found


def lane_problems(lanes: Any) -> list[str]:
    if not isinstance(lanes, dict):
        return ["レーンがない"]
    problems = []
    for lane, label in LANES.items():
        entry = lanes.get(lane)
        if not isinstance(entry, dict) or entry.get("result") not in PASSING | {"FAIL"}:
            problems.append(f"{label}の結果がない")
        elif not isinstance(entry.get("evidence"), list) or not entry["evidence"]:
            problems.append(f"{label}の証跡がない")
    return problems


def verdict_problems(verdict: dict[str, Any], authors: set[str]) -> list[str]:
    problems = lane_problems(verdict.get("lanes"))
    if verdict.get("verdict") not in PASSING:
        problems.append(f"判定が {verdict.get('verdict')}")
    lanes = verdict.get("lanes") if isinstance(verdict.get("lanes"), dict) else {}
    failing = [label for lane, label in LANES.items() if isinstance(lanes.get(lane), dict) and lanes[lane].get("result") == "FAIL"]
    if failing:
        problems.append(f"{'、'.join(failing)}がFAIL")
    verifiers = {model_id(m) for m in verdict.get("verifier_models", [])}
    if not verifiers:
        problems.append("検証したモデルの記録がない")
    known_authors = authors | {model_id(m) for m in verdict.get("author_models", [])}
    if not known_authors:
        problems.append("実装したモデルが分からない。Co-Authored-By か判定の author_models で示す")
    same = overlapping(verifiers, known_authors)
    if same:
        problems.append(f"実装と同じモデルが検証している: {', '.join(same)}")
    if verdict.get("human_only"):
        problems.append(f"検証者が人間の判断が要る変更と判定: {verdict.get('human_only_reason', '')}")
    return problems


MERGE_PREFIX = "[merge]"


def merge_authorization(repo: str, number: int, pr: dict[str, Any]) -> tuple[bool, str]:
    """manual mode: a person put [merge] at the start of the PR title after the last push.

    The title must carry the prefix now, and the rename that added it must be newer than
    the latest commit and any force-push, so commits pushed after the approval are not
    merged unseen. Commit dates come from git and can be set by whoever commits; this
    check keeps honest runs honest, it does not stop a hostile one.
    """
    if not pr["title"].startswith(MERGE_PREFIX):
        return False, f"タイトルが {MERGE_PREFIX} で始まっていない。人がタイトル先頭に {MERGE_PREFIX} を付けるとマージする"
    events = api_items(f"repos/{repo}/issues/{number}/timeline?per_page=100")
    added = [e["created_at"] for e in events if e.get("event") == "renamed"
             and str((e.get("rename") or {}).get("to", "")).startswith(MERGE_PREFIX)
             and not str((e.get("rename") or {}).get("from", "")).startswith(MERGE_PREFIX)]
    pushed = [e["created_at"] for e in events if e.get("event") == "head_ref_force_pushed"]
    pushed += [c["commit"]["committer"]["date"] for c in api_items(f"repos/{repo}/pulls/{number}/commits?per_page=100")]
    if not added:
        return False, f"{MERGE_PREFIX} はPR作成時から付いている。作成後に人が付けた記録がない"
    last_push = max(pushed) if pushed else ""
    if max(added) <= last_push:
        return False, f"{MERGE_PREFIX} を付けた後（{max(added)}）に新しいコミットがある（{last_push}）。見直して付け直す"
    return True, f"{max(added)} に付けられた"


def evaluate(repo: str, number: int) -> tuple[list[Check], dict[str, Any]]:
    checks: list[Check] = []

    def add(name: str, ok: bool, detail: str) -> None:
        checks.append((name, ok, detail))

    add("停止スイッチ", not STOP_PATH.exists(), f"{STOP_PATH} がある" if STOP_PATH.exists() else "なし")
    policy, repo_cfg = load_policy(repo)
    add("対象リポジトリ", repo_cfg is not None, f"repos/{repo_cfg['file']}" if repo_cfg else "どの repos/*.yaml にもない")
    repo_cfg = repo_cfg or {"merge": {"mode": "manual"}, "downgrades": []}
    mode = repo_cfg["merge"]["mode"]
    rules = repo_cfg["merge"]

    pr = pull_request(repo, number)
    head, base = pr["head"]["sha"], pr["base"]["ref"]
    add("PRの状態", pr["state"] == "open" and not pr["draft"], f"state={pr['state']} draft={pr['draft']}")
    add("マージの方式", True, mode + ("（" + " / ".join(repo_cfg["downgrades"]) + "）" if repo_cfg.get("downgrades") else ""))

    tip = branch_tip(repo, base)
    behind = api(f"repos/{repo}/compare/{tip}...{head}")["behind_by"]
    add("trunkの先端に載っている", behind == 0, f"{base} {tip[:7]} から behind_by={behind}")
    add("衝突なし", pr["mergeable"] is True and pr["mergeable_state"] != "dirty", f"mergeable={pr['mergeable']} state={pr['mergeable_state']}")

    runs = api_items(f"repos/{repo}/commits/{head}/check-runs?per_page=100", ".check_runs[]")
    statuses = api(f"repos/{repo}/commits/{head}/status")["statuses"]
    waiting = [r["name"] for r in runs if r["status"] != "completed"] + [s["context"] for s in statuses if s["state"] == "pending"]
    failing = [r["name"] for r in runs if r["status"] == "completed" and r["conclusion"] not in GREEN]
    failing += [s["context"] for s in statuses if s["state"] in {"failure", "error"}]
    expected = rules["ci_required"] if "ci_required" in rules else has_workflows(repo, head)
    if not runs and not statuses:
        add("CI", not expected, "ワークフローがあるのに、このheadでCIがまだ走っていない" if expected else "CIなし。検証のゲートレーンが代わる")
    else:
        add("CI", not waiting and not failing, f"実行中 {waiting} 失敗 {failing}" if waiting or failing else f"{len(runs) + len(statuses)}件、失敗なし")

    latest: dict[str, dict[str, Any]] = {}
    for review in api_items(f"repos/{repo}/pulls/{number}/reviews?per_page=100"):
        if review["state"] != "COMMENTED":
            latest[review["user"]["login"]] = review
    fresh = sorted(user for user, review in latest.items() if review["state"] == "APPROVED" and review["commit_id"] == head)
    changes = sorted(user for user, review in latest.items() if review["state"] == "CHANGES_REQUESTED")
    add("変更要求なし", not changes, ", ".join(changes) or "なし")

    files = api_items(f"repos/{repo}/pulls/{number}/files?per_page=100")
    fingerprint = patch_id(repo, number, files)
    authors: set[str] = set()

    if mode == "manual":
        ok, detail = merge_authorization(repo, number, pr)
        add("人のマージ許可", ok, detail)
        needed = int(rules.get("approvals", 0))
        if needed:
            add("今のheadへの承認", len(fresh) >= needed, f"{len(fresh)}/{needed} {', '.join(fresh)}")
    else:
        human = rules.get("human_branches") or {}
        reason = human.get(base) or human.get("*")
        add("人が判断するブランチ", reason is None, reason or f"{base} は自動の対象")
        guarded = tuple(policy.get("human_paths", []))
        touched = sorted({name for f in files for name in (f["filename"], f.get("previous_filename") or "")
                          if name and name.startswith(guarded)})
        add("人が見るファイル", not touched, ", ".join(touched) or "なし")
        implementer = implementer_login()
        needed = int(rules.get("approvals", 0))
        if needed:
            humans = [u for u in fresh if u != implementer]
            add("今のheadへの人の承認", len(humans) >= needed, f"{len(humans)}/{needed} {', '.join(humans)}")
        authors = author_models(api_items(f"repos/{repo}/pulls/{number}/commits?per_page=100"))
        verdict = latest_verdict(repo, number, head, tip)
        if verdict is None:
            add("独立検証の判定", False, f"head {head[:7]}（{base} {tip[:7]} の上）への判定がない")
        else:
            problems = verdict_problems(verdict, authors)
            add("独立検証の判定", not problems, "; ".join(problems) or f"{verdict['verdict']}（{', '.join(verdict['verifier_models'])}）{verdict['url']}")

    return checks, {
        "pr": pr, "head": head, "base": base, "tip": tip, "rules": rules,
        "fingerprint": fingerprint, "authors": authors,
    }


def watch_runs(repo: str, sha: str, workflow: str) -> list[dict[str, Any]]:
    """Wait for the named deploy workflow on the merge commit. Returns the failed runs."""
    deadline = time.monotonic() + DEPLOY_WAIT_SECONDS
    settled_at = None
    while time.monotonic() < deadline:
        runs = [run for run in api_items(f"repos/{repo}/actions/runs?head_sha={sha}&per_page=100", ".workflow_runs[]")
                if run["name"] == workflow]
        if runs and all(run["status"] == "completed" for run in runs):
            settled_at = settled_at or time.monotonic()
            if time.monotonic() - settled_at >= 90:
                return [run for run in runs if run["conclusion"] not in GREEN]
        else:
            settled_at = None
        time.sleep(30)
    raise Refused(f"配備ワークフロー {workflow} が45分たっても終わらない")


def open_revert(node_id: str) -> str:
    query = "mutation($id: ID!) { revertPullRequest(input: {pullRequestId: $id}) { revertPullRequest { url } } }"
    result = json.loads(gh("api", "graphql", "-f", f"query={query}", "-f", f"id={node_id}"))
    return result["data"]["revertPullRequest"]["revertPullRequest"]["url"]


def notify(message: str) -> None:
    script = f"display notification {json.dumps(message, ensure_ascii=False)} with title \"sirius-merge\""
    subprocess.run(["osascript", "-e", script], check=False, capture_output=True)


def log(repo: str, number: int, head: str, action: str, detail: str) -> None:
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    fresh = not LOG_PATH.exists()
    cells = [datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), repo, str(number), head[:12], action, detail]
    with LOG_PATH.open("a") as handle:
        if fresh:
            handle.write("ts\trepo\tpr\thead\taction\tdetail\n")
        handle.write("\t".join(re.sub(r"[\t\r\n]+", " ", cell) for cell in cells) + "\n")


def show(checks: list[Check]) -> None:
    for name, ok, detail in checks:
        print(f"{'OK' if ok else 'NG'}  {name}: {detail}")


def cmd_check(repo: str, number: int) -> int:
    checks, _ = evaluate(repo, number)
    show(checks)
    return 0 if all(ok for _, ok, _ in checks) else 1


def deploy_settled(repo: str, number: int) -> bool:
    if not LOG_PATH.exists():
        return False
    rows = (line.split("\t") for line in LOG_PATH.read_text().splitlines()[1:])
    return any(len(cells) > 4 and cells[1] == repo and cells[2] == str(number) and cells[4] in {"deploy-ok", "deploy-failed", "deploy-unverified"} for cells in rows)


def follow_deploy(repo: str, number: int, pr: dict[str, Any], deploy: str, workflow: str | None) -> int:
    head, merge_sha = pr["head"]["sha"], pr["merge_commit_sha"]
    if not workflow:
        # Nothing on GitHub identifies the deploy, so success cannot be claimed.
        log(repo, number, head, "deploy-unverified", deploy)
        notify(f"{repo}#{number} をマージした。配備（{deploy}）は自動で確認できないので、手で確認してください")
        print(f"配備（{deploy}）を確認するワークフローが設定されていない。手で確認する", file=sys.stderr)
        return 2
    print(f"配備ワークフロー {workflow} を待つ: {deploy}")
    try:
        broken = watch_runs(repo, merge_sha, workflow)
    except Refused as error:
        log(repo, number, head, "deploy-unknown", str(error))
        notify(f"{repo}#{number} のマージ後の配備を確認できない: {error}")
        print(f"配備を確認できない。もう一度 merge を実行すると監視から再開する: {error}", file=sys.stderr)
        return 2
    if not broken:
        log(repo, number, head, "deploy-ok", deploy)
        print("マージ後のワークフローに失敗なし")
        return 0
    names = ", ".join(f"{run['name']}={run['conclusion']}" for run in broken)
    try:
        revert_url = open_revert(pr["node_id"])
    except Refused as error:
        revert_url = f"作れなかった（{error}）"
    log(repo, number, head, "deploy-failed", f"{names} revert {revert_url}")
    notify(f"{repo}#{number} のマージ後に失敗: {names}。revert PR {revert_url}")
    print(f"マージ後に失敗: {names}\nrevert PRを作った: {revert_url}", file=sys.stderr)
    return 2


def drift_since_check(repo: str, number: int, context: dict[str, Any]) -> list[str]:
    """Run every check again and compare. Catches withdrawn approvals, rerun CI, and setting changes."""
    checks, again = evaluate(repo, number)
    drift = [f"{name}: {detail}" for name, ok, detail in checks if not ok]
    if again["head"] != context["head"]:
        drift.append("headが動いた")
    if again["base"] != context["base"]:
        drift.append("宛先ブランチが変わった")
    if again["tip"] != context["tip"]:
        drift.append("trunkの先端が動いた")
    return drift


def cmd_merge(repo: str, number: int) -> int:
    current = api(f"repos/{repo}/pulls/{number}")
    if current["merged"]:
        print(f"マージ済み: {current['merge_commit_sha']}")
        _, repo_cfg = load_policy(repo)
        rules = (repo_cfg or {}).get("merge") or {}
        deploy = (rules.get("deploys") or {}).get(current["base"]["ref"])
        workflow = (rules.get("deploy_workflows") or {}).get(current["base"]["ref"])
        return follow_deploy(repo, number, current, deploy, workflow) if deploy and not deploy_settled(repo, number) else 0
    checks, context = evaluate(repo, number)
    show(checks)
    head, base = context["head"], context["base"]
    failed = [f"{name}: {detail}" for name, ok, detail in checks if not ok]
    if failed:
        log(repo, number, head, "refused", " / ".join(failed))
        return 1
    drift = drift_since_check(repo, number, context)
    if drift:
        print(f"NG  検査後の変化: {', '.join(drift)}")
        log(repo, number, head, "refused", f"検査後の変化: {', '.join(drift)}")
        return 1

    try:
        gh("pr", "merge", str(number), "-R", repo, "--squash", "--match-head-commit", head)
    except Refused:
        if not api(f"repos/{repo}/pulls/{number}")["merged"]:
            raise
    merged = api(f"repos/{repo}/pulls/{number}")
    if not merged["merged"]:
        raise Refused("マージ後に取り直したPRがmergedになっていない")
    merge_sha = merged["merge_commit_sha"]
    tip = branch_tip(repo, base)
    if api(f"repos/{repo}/compare/{merge_sha}...{tip}")["behind_by"] != 0:
        raise Refused(f"マージコミット {merge_sha[:7]} が {base} に見当たらない")
    log(repo, number, head, "merged", f"{merge_sha} patch-id {context['fingerprint']}")
    print(f"マージした: {merged['html_url']} → {base} {merge_sha[:7]}")

    deploy = (context["rules"].get("deploys") or {}).get(base)
    workflow = (context["rules"].get("deploy_workflows") or {}).get(base)
    return follow_deploy(repo, number, merged, deploy, workflow) if deploy else 0


def cmd_verdict(repo: str, number: int, spec_path: Path) -> int:
    spec = json.loads(spec_path.read_text())
    pr = pull_request(repo, number)
    head = pr["head"]["sha"]
    if spec.get("head_sha") != head:
        raise Refused(f"検証したhead {spec.get('head_sha')} と今のhead {head} が違う。検証し直す")
    tip = branch_tip(repo, pr["base"]["ref"])
    if spec.get("base_sha") != tip:
        raise Refused(f"検証したbase {spec.get('base_sha')} と今の {pr['base']['ref']} の先端 {tip} が違う。載せ直して検証し直す")
    problems = lane_problems(spec.get("lanes"))
    if problems:
        raise Refused("; ".join(problems))
    live = spec["lanes"]["live"]["evidence"]
    if not any(Path(item).expanduser().is_file() for item in live):
        raise Refused("実画面の証跡に実在するファイルがない")
    files = api_items(f"repos/{repo}/pulls/{number}/files?per_page=100")
    authors = author_models(api_items(f"repos/{repo}/pulls/{number}/commits?per_page=100"))
    authors |= {model_id(m) for m in spec.get("author_models", [])}
    verifiers = {model_id(m) for m in spec.get("verifier_models", [])}
    if not authors:
        raise Refused("実装したモデルが分からない。Co-Authored-By がなければ author_models で示す")
    same = overlapping(verifiers, authors)
    if not verifiers or same:
        raise Refused(f"検証したモデルが空か、実装と同じ: {', '.join(same)}")

    results = {spec["lanes"][lane]["result"] for lane in LANES}
    verdict = "FAIL" if "FAIL" in results else "PASS+NOTES" if "PASS+NOTES" in results else "PASS"
    payload = {
        "verdict": verdict,
        "head_sha": head,
        "base_sha": tip,
        "patch_id": patch_id(repo, number, files),
        "lanes": {lane: spec["lanes"][lane] for lane in LANES},
        "verifier_models": sorted(verifiers),
        "author_models": sorted(authors),
        "human_only": bool(spec.get("human_only")),
        "human_only_reason": spec.get("human_only_reason", ""),
        "created_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    }
    gh("pr", "comment", str(number), "-R", repo, "--body-file", "-", stdin=render(payload, spec))
    log(repo, number, head, "verdict", f"{verdict} by {', '.join(sorted(verifiers))} patch-id {payload['patch_id']}")
    print(f"判定を投稿した: {verdict} head {head[:7]} patch-id {payload['patch_id']}")
    return 0


def render(payload: dict[str, Any], spec: dict[str, Any]) -> str:
    def cell(text: str) -> str:
        return text.replace("|", "\\|").replace("\n", " ")

    rows = []
    for lane, label in LANES.items():
        entry = payload["lanes"][lane]
        notes = "<br>".join(cell(n) for n in entry.get("notes", []))
        evidence = "<br>".join(f"`{cell(e)}`" for e in entry["evidence"])
        rows.append(f"| {label} | {entry['result']} | {notes} | {evidence} |")
    human = f"\n\n人間の判断が要る変更: はい。{payload['human_only_reason']}" if payload["human_only"] else ""
    marker = json.dumps(payload, ensure_ascii=False).replace("-->", "--\\u003e")
    return "\n".join([
        f"{MARKER}{marker} -->",
        f"## 独立検証の判定: {payload['verdict']}（head `{payload['head_sha'][:7]}`）",
        "",
        f"実装していないモデルが検証しました。検証は {', '.join(payload['verifier_models'])}、実装は {', '.join(payload['author_models']) or '記録なし'} です。",
        "",
        "| レーン | 結果 | 所見 | 証跡 |",
        "| --- | --- | --- | --- |",
        *rows,
        "",
        spec.get("summary", "").strip() + human,
        "",
        f"`sirius-merge` はこの判定を head `{payload['head_sha'][:7]}` と base `{payload['base_sha'][:7]}` の組に対してだけ使います。",
    ])


COMMANDS = {"check", "merge", "verdict"}


def main(argv: list[str]) -> int:
    if len(argv) < 3 or argv[0] not in COMMANDS or not re.fullmatch(r"[\w.-]+/[\w.-]+", argv[1]) or not argv[2].isdigit():
        print(__doc__, file=sys.stderr)
        return 64
    command, repo, number = argv[0], argv[1], int(argv[2])
    try:
        if command == "check":
            return cmd_check(repo, number)
        if command == "merge":
            return cmd_merge(repo, number)
        if len(argv) != 4:
            print(__doc__, file=sys.stderr)
            return 64
        return cmd_verdict(repo, number, Path(argv[3]))
    except Refused as error:
        print(f"中止: {error}", file=sys.stderr)
        log(repo, number, "", f"{command}-error", str(error))
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
