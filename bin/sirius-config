#!/usr/bin/env python3
"""Load, validate, and resolve Sirius configuration from ~/.sirius.

Global: ~/.sirius/config.yaml
Repos:  ~/.sirius/repos/<owner>__<repo>.yaml   (one file per GitHub repository)
Workspaces: ~/.sirius/workspaces/<name>.yaml (optional; sources shared by several repos)

Investigation method, review approach, and verification method are decided per
repository, so the unit of configuration is one repository, not an abstract
"project". A workspace groups repos that share one Slack channel or LINE chat:
it owns those sources and the reply, and intake routes each request to the
member repos it affects. Every source has exactly one owner. A repo file is
keyed by its own `repo: owner/repo` field, and the file name must equal that
repo lowercased with "/" replaced by "__".

Gate settings (implement.gate, merge.mode, reply.mode) resolve to the stricter
of the global ceiling in config.yaml and the repo's own value. Nothing inside
a project repository is read, so a PR cannot loosen its own gate.
"""

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

HOME = Path(os.environ.get("SIRIUS_HOME", Path.home() / ".sirius"))

# Ordered from strictest to loosest.
IMPLEMENT_GATES = ["human", "auto"]
MERGE_MODES = ["manual", "auto"]
REPLY_MODES = ["draft", "send"]
SCHEDULERS = ["none", "loop", "launchd", "monitor"]
AGENTS = ["claude", "codex"]

GLOBAL_DEFAULTS = {
    "version": 1,
    "scheduler": "none",
    "implementer": "claude",
    "implementer_model": "",
    "implementer_effort": "",
    "reviewer": "codex",
    "reviewer_model": "",
    "reviewer_effort": "",
    "implement_gate": "human",
    "merge": "manual",
    "reply": {"mode": "draft"},
    "human_paths": [".github/workflows/"],
    "limits": {"new_issues_per_source": 5, "concurrent_workers": 2},
}

REPO_KEYS = {
    "repo", "dir", "sources", "reply", "investigate", "implement", "review",
    "verify", "merge", "forbidden", "notes",
}
SOURCE_KINDS = {"slack", "line"}
RULE_KEYS = {"ci_required", "approvals", "human_branches", "deploys", "deploy_workflows"}
MERGE_KEYS = RULE_KEYS | {"mode"}
WORKSPACE_KEYS = {"name", "dir", "repos", "sources", "reply", "notes"}
WORKSPACE_NAME = re.compile(r"[a-z0-9][a-z0-9-]*")


class ConfigError(Exception):
    pass


def load_yaml(path):
    text = path.read_text(encoding="utf-8")
    try:
        import yaml  # type: ignore
        return yaml.safe_load(text) or {}
    except ImportError:
        pass
    # macOS ships Ruby with Psych, so use it when PyYAML is absent.
    try:
        out = subprocess.run(
            ["ruby", "-ryaml", "-rjson", "-e",
             "puts JSON.generate(YAML.safe_load(STDIN.read) || {})"],
            input=text, capture_output=True, text=True, check=True,
        ).stdout
        return json.loads(out)
    except (OSError, subprocess.CalledProcessError) as exc:
        raise ConfigError(
            f"{path}: no YAML parser (install PyYAML: python3 -m pip install pyyaml)"
        ) from exc


def expand(p):
    return str(Path(os.path.expanduser(p)).resolve()) if p else None


def stricter(order, a, b):
    return a if order.index(a) <= order.index(b) else b


def load_global():
    path = HOME / "config.yaml"
    if not path.exists():
        raise ConfigError(f"{path} not found; run /sirius:setup")
    data = load_yaml(path)
    if not isinstance(data, dict):
        raise ConfigError(f"{path}: top level must be a mapping")
    cfg = {**GLOBAL_DEFAULTS, **data}
    # reply is a nested mapping; merge it one level deep so a partial
    # `reply: {style: ...}` in config.yaml does not silently drop the default mode.
    cfg["reply"] = {**GLOBAL_DEFAULTS["reply"], **(data.get("reply") or {})}
    errors = []
    for key, allowed in (("implement_gate", IMPLEMENT_GATES), ("merge", MERGE_MODES),
                         ("scheduler", SCHEDULERS), ("implementer", AGENTS), ("reviewer", AGENTS)):
        if cfg[key] not in allowed:
            errors.append(f"{path}: {key} must be one of {allowed}")
    if cfg["reply"].get("mode") not in REPLY_MODES:
        errors.append(f"{path}: reply.mode must be one of {REPLY_MODES}")
    for key in ("implementer_model", "implementer_effort", "reviewer_model", "reviewer_effort"):
        if not isinstance(cfg.get(key, ""), str):
            errors.append(f"{path}: {key} must be a string")
    if errors:
        raise ConfigError("\n".join(errors))
    return cfg


def _str_list_errors(path, label, value):
    if value is None:
        return []
    if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
        return [f"{path}: {label} must be a list of strings"]
    return []


def _dict_list_errors(path, label, value, keys):
    """A list of mappings, each with exactly `keys`, all non-empty strings."""
    if value is None:
        return []
    if not isinstance(value, list):
        return [f"{path}: {label} must be a list"]
    errors = []
    for i, entry in enumerate(value):
        where = f"{path}: {label}[{i}]"
        if not isinstance(entry, dict):
            errors.append(f"{where} must be a mapping")
            continue
        unknown = set(entry) - keys
        missing = keys - set(entry)
        if unknown:
            errors.append(f"{where}: unknown keys {sorted(unknown)}")
        if missing:
            errors.append(f"{where}: missing keys {sorted(missing)}")
        for k in keys & set(entry):
            if not isinstance(entry[k], str) or not entry[k].strip():
                errors.append(f"{where}.{k} must be a non-empty string")
    return errors


def validate_merge(path, merge):
    """merge loosens nothing silently: unknown keys and bad values are errors."""
    errors = []
    if not isinstance(merge, dict):
        return [f"{path}: merge must be a mapping"]
    unknown = set(merge) - MERGE_KEYS
    if unknown:
        errors.append(f"{path}: merge has unknown keys {sorted(unknown)}")
    if "mode" in merge and merge["mode"] not in MERGE_MODES:
        errors.append(f"{path}: merge.mode must be one of {MERGE_MODES}")
    if "ci_required" in merge and not isinstance(merge["ci_required"], bool):
        errors.append(f"{path}: merge.ci_required must be true or false")
    if "approvals" in merge and (not isinstance(merge["approvals"], int)
                                 or isinstance(merge["approvals"], bool) or merge["approvals"] < 0):
        errors.append(f"{path}: merge.approvals must be a non-negative integer")
    for key in ("human_branches", "deploys", "deploy_workflows"):
        value = merge.get(key, {})
        if not isinstance(value, dict) or not all(
                isinstance(k, str) and isinstance(v, str) and v.strip() for k, v in value.items()):
            errors.append(f"{path}: merge.{key} must map branch names to non-empty text")
    return errors


def validate_sources(path, sources):
    errors = []
    sources = sources or {}
    if not isinstance(sources, dict):
        return [f"{path}: sources must be a mapping"]
    for kind, entries in sources.items():
        if kind not in SOURCE_KINDS:
            errors.append(f"{path}: unknown source kind {kind!r}")
            continue
        for e in entries or []:
            if kind == "slack" and not (isinstance(e, dict) and e.get("workspace") and e.get("channel")):
                errors.append(f"{path}: slack entry needs exact workspace and channel IDs: {e!r}")
            if kind == "line" and not (isinstance(e, dict) and e.get("chat")):
                errors.append(f"{path}: line entry needs an exact chat title: {e!r}")
            if isinstance(e, dict) and any("*" in str(v) for v in e.values()):
                errors.append(f"{path}: wildcards do not grant scope: {e!r}")
    return errors


def validate_reply(path, reply):
    reply = reply or {}
    if not isinstance(reply, dict):
        return [f"{path}: reply must be a mapping"]
    errors = []
    if "mode" in reply and reply["mode"] not in REPLY_MODES:
        errors.append(f"{path}: reply.mode must be one of {REPLY_MODES}")
    if "style" in reply and not isinstance(reply["style"], str):
        errors.append(f"{path}: reply.style must be a string")
    errors.extend(_str_list_errors(path, "reply.never", reply.get("never")))
    return errors


def validate_repo(path, data):
    errors = []
    if not isinstance(data, dict):
        return [f"{path}: top level must be a mapping"]
    unknown = set(data) - REPO_KEYS
    if unknown:
        errors.append(f"{path}: unknown keys {sorted(unknown)}")

    repo = data.get("repo")
    if not isinstance(repo, str) or repo.count("/") != 1 or "*" in repo:
        errors.append(f"{path}: repo must be an exact owner/repo string")
        repo = None
    if repo:
        expected_stem = repo.lower().replace("/", "__")
        if path.stem != expected_stem:
            errors.append(f"{path}: file name must be {expected_stem}.yaml (derived from repo {repo!r})")

    errors.extend(validate_sources(path, data.get("sources")))
    errors.extend(validate_reply(path, data.get("reply")))

    investigate = data.get("investigate") or {}
    if not isinstance(investigate, dict):
        errors.append(f"{path}: investigate must be a mapping")
        investigate = {}
    else:
        errors.extend(_str_list_errors(path, "investigate.read_first", investigate.get("read_first")))
        errors.extend(_dict_list_errors(path, "investigate.knowledge", investigate.get("knowledge"),
                                        {"where", "what"}))
        errors.extend(_str_list_errors(path, "investigate.ask_user_when", investigate.get("ask_user_when")))

    implement = data.get("implement") or {}
    if not isinstance(implement, dict):
        errors.append(f"{path}: implement must be a mapping")
        implement = {}
    else:
        if "gate" in implement and implement["gate"] not in IMPLEMENT_GATES:
            errors.append(f"{path}: implement.gate must be one of {IMPLEMENT_GATES}")
        errors.extend(_str_list_errors(path, "implement.conventions", implement.get("conventions")))

    review = data.get("review") or {}
    if not isinstance(review, dict):
        errors.append(f"{path}: review must be a mapping")
        review = {}
    else:
        if review.get("reviewer") and review["reviewer"] not in AGENTS:
            errors.append(f"{path}: review.reviewer must be one of {AGENTS}")
        errors.extend(_str_list_errors(path, "review.focus", review.get("focus")))

    verify = data.get("verify") or {}
    if not isinstance(verify, dict):
        errors.append(f"{path}: verify must be a mapping")
        verify = {}
    else:
        errors.extend(_str_list_errors(path, "verify.commands", verify.get("commands")))
        errors.extend(_dict_list_errors(path, "verify.live", verify.get("live"), {"how", "evidence"}))
        errors.extend(_str_list_errors(path, "verify.not_enough", verify.get("not_enough")))

    errors.extend(validate_merge(path, data.get("merge") or {}))
    errors.extend(_str_list_errors(path, "forbidden", data.get("forbidden")))

    if "notes" in data and not isinstance(data["notes"], str):
        errors.append(f"{path}: notes must be a string")
    if "dir" in data and data["dir"] is not None and not isinstance(data["dir"], str):
        errors.append(f"{path}: dir must be a string")

    return errors


def resolve(glob, path, data):
    """Return the effective repo config plus reasons for any downgrade."""
    notes = []

    declared_gate = (data.get("implement") or {}).get("gate", "human")
    gate = stricter(IMPLEMENT_GATES, glob["implement_gate"], declared_gate)

    raw_merge = data.get("merge") or {}
    declared_merge_mode = raw_merge.get("mode", "manual")
    merge_mode = stricter(MERGE_MODES, glob["merge"], declared_merge_mode)
    if merge_mode != declared_merge_mode:
        notes.append(f"merge capped at {merge_mode!r} by config.yaml")
    # The repo's own review.reviewer overrides the global reviewer (same fallback the
    # resolved "review" block below uses), so the "different model" check must compare
    # against the model that will actually review this repo, not always the global one.
    effective_reviewer = (data.get("review") or {}).get("reviewer") or glob["reviewer"]
    if merge_mode == "auto" and glob["implementer"] == effective_reviewer:
        merge_mode = "manual"
        notes.append("merge auto needs a reviewer model different from the implementer; using 'manual'")

    declared_reply = (data.get("reply") or {}).get("mode", "draft")
    reply_mode = stricter(REPLY_MODES, glob["reply"]["mode"], declared_reply)
    if reply_mode != declared_reply:
        notes.append(f"reply capped at {reply_mode!r} by config.yaml")

    merge_block = {"mode": merge_mode}
    for key in RULE_KEYS:
        if key in raw_merge:
            merge_block[key] = raw_merge[key]

    reply = data.get("reply") or {}
    investigate = data.get("investigate") or {}
    implement = data.get("implement") or {}
    review = data.get("review") or {}
    verify = data.get("verify") or {}

    return {
        "repo": data["repo"].lower(),
        "file": path.name,
        "dir": expand(data.get("dir")),
        "sources": {
            "slack": (data.get("sources") or {}).get("slack") or [],
            "line": (data.get("sources") or {}).get("line") or [],
        },
        "reply": {
            "mode": reply_mode,
            "style": reply.get("style") or "",
            "never": reply.get("never") or [],
        },
        "investigate": {
            "read_first": investigate.get("read_first") or [],
            "knowledge": investigate.get("knowledge") or [],
            "ask_user_when": investigate.get("ask_user_when") or [],
        },
        "implement": {
            "gate": gate,
            "conventions": implement.get("conventions") or [],
            "model": glob["implementer_model"],
            "effort": glob["implementer_effort"],
        },
        "review": {
            "reviewer": review.get("reviewer") or glob["reviewer"],
            "focus": review.get("focus") or [],
            "model": glob["reviewer_model"],
            "effort": glob["reviewer_effort"],
        },
        "verify": {
            "commands": verify.get("commands") or [],
            "live": verify.get("live") or [],
            "not_enough": verify.get("not_enough") or [],
        },
        "merge": merge_block,
        "forbidden": data.get("forbidden") or [],
        "notes": data.get("notes") or "",
        "downgrades": notes,
    }


def validate_workspace(path, data, known_repos):
    errors = []
    if not isinstance(data, dict):
        return [f"{path}: top level must be a mapping"]
    unknown = set(data) - WORKSPACE_KEYS
    if unknown:
        errors.append(f"{path}: unknown keys {sorted(unknown)}")
    name = data.get("name")
    if not isinstance(name, str) or not WORKSPACE_NAME.fullmatch(name):
        errors.append(f"{path}: name must match {WORKSPACE_NAME.pattern}")
    elif path.stem != name:
        errors.append(f"{path}: file name must be {name}.yaml (derived from name {name!r})")
    members = data.get("repos")
    if not isinstance(members, list) or not members or not all(isinstance(r, str) for r in members):
        errors.append(f"{path}: repos must be a non-empty list of owner/repo strings")
    else:
        for r in members:
            if r.lower() not in known_repos:
                errors.append(f"{path}: repo {r!r} has no file in repos/")
        if len({r.lower() for r in members}) != len(members):
            errors.append(f"{path}: repos lists a repository twice")
    errors.extend(validate_sources(path, data.get("sources")))
    errors.extend(validate_reply(path, data.get("reply")))
    if "notes" in data and not isinstance(data["notes"], str):
        errors.append(f"{path}: notes must be a string")
    if "dir" in data and data["dir"] is not None and not isinstance(data["dir"], str):
        errors.append(f"{path}: dir must be a string")
    return errors


def resolve_workspace(glob, path, data):
    """A workspace owns sources shared by several repos. Gates stay per repo; only the
    reply to the requester is decided here, because one request gets one reply."""
    notes = []
    reply = data.get("reply") or {}
    declared_reply = reply.get("mode", "draft")
    reply_mode = stricter(REPLY_MODES, glob["reply"]["mode"], declared_reply)
    if reply_mode != declared_reply:
        notes.append(f"reply capped at {reply_mode!r} by config.yaml")
    return {
        "name": data["name"],
        "file": path.name,
        "dir": expand(data.get("dir")),
        "repos": [r.lower() for r in data["repos"]],
        "sources": {
            "slack": (data.get("sources") or {}).get("slack") or [],
            "line": (data.get("sources") or {}).get("line") or [],
        },
        "reply": {
            "mode": reply_mode,
            "style": reply.get("style") or "",
            "never": reply.get("never") or [],
        },
        "notes": data.get("notes") or "",
        "downgrades": notes,
    }


def source_keys(sources):
    for e in sources["slack"]:
        yield ("slack", e["workspace"], e["channel"])
    for e in sources["line"]:
        yield ("line", e["chat"])


def load_workspaces(glob, repos):
    """Workspaces, plus the rule that makes them necessary: every source is read by
    exactly one owner (a repo or a workspace), or one message becomes several Issues
    and several replies."""
    workspaces, errors = [], []
    wdir = HOME / "workspaces"
    known = {r["repo"] for r in repos}
    for path in sorted(wdir.glob("*.yaml")) if wdir.exists() else []:
        try:
            data = load_yaml(path)
        except ConfigError as exc:
            errors.append(str(exc))
            continue
        errs = validate_workspace(path, data, known)
        if errs:
            errors.extend(errs)
            continue
        workspaces.append(resolve_workspace(glob, path, data))
    member_of = {}
    for w in workspaces:
        for r in w["repos"]:
            if r in member_of:
                errors.append(f"repo {r} belongs to both {member_of[r]} and {w['file']}")
            member_of[r] = w["file"]
    owner = {}
    for label, sources in [(r["file"], r["sources"]) for r in repos] + \
                          [(w["file"], w["sources"]) for w in workspaces]:
        for key in source_keys(sources):
            if key in owner and owner[key] != label:
                errors.append(f"source {':'.join(key)} is listed in both {owner[key]} and {label}; "
                              "list it once, in a workspace if several repos share it")
            owner.setdefault(key, label)
    return workspaces, errors


def load_all():
    glob = load_global()
    repos, errors = [], []
    rdir = HOME / "repos"
    for path in sorted(rdir.glob("*.yaml")) if rdir.exists() else []:
        try:
            data = load_yaml(path)
        except ConfigError as exc:
            errors.append(str(exc))
            continue
        errs = validate_repo(path, data)
        if errs:
            errors.extend(errs)
            continue
        repos.append(resolve(glob, path, data))
    seen = {}
    for r in repos:
        if r["repo"] in seen:
            errors.append(f"repo {r['repo']} is claimed by both {seen[r['repo']]} and {r['file']}")
        seen[r["repo"]] = r["file"]
    return glob, repos, errors


def find_by_dir(repos, cwd):
    # samefile, not string comparison: macOS paths are case-insensitive.
    chain = [Path(cwd).resolve(), *Path(cwd).resolve().parents]
    best, best_depth = None, -1
    for r in repos:
        if not r["dir"] or not Path(r["dir"]).exists():
            continue
        for depth, c in enumerate(reversed(chain)):
            if c.samefile(r["dir"]) and depth > best_depth:
                best, best_depth = r, depth
    return best


def main():
    ap = argparse.ArgumentParser(prog="sirius-config")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("validate")
    sub.add_parser("show")
    rp = sub.add_parser(
        "repo",
        help="Show one repo's resolved config, by exact owner/repo or by --dir (default: cwd).",
    )
    group = rp.add_mutually_exclusive_group()
    group.add_argument("repo", nargs="?", help="exact owner/repo")
    group.add_argument("--dir", default=None, help="a checkout directory (default: current directory)")
    wp = sub.add_parser(
        "workspace",
        help="Show one workspace's resolved config, by name or by --dir (default: cwd).",
    )
    wgroup = wp.add_mutually_exclusive_group()
    wgroup.add_argument("name", nargs="?", help="workspace name")
    wgroup.add_argument("--dir", default=None, help="the workspace directory (default: current directory)")
    args = ap.parse_args()

    try:
        glob, repos, errors = load_all()
        workspaces, ws_errors = load_workspaces(glob, repos)
    except ConfigError as exc:
        print(json.dumps({"ok": False, "errors": str(exc).splitlines()}, ensure_ascii=False))
        return 2
    errors += ws_errors
    for r in repos:
        r["workspace"] = next((w["name"] for w in workspaces if r["repo"] in w["repos"]), None)

    if args.cmd == "validate":
        print(json.dumps({"ok": not errors, "errors": errors,
                          "repos": [r["repo"] for r in repos],
                          "workspaces": [w["name"] for w in workspaces]}, ensure_ascii=False, indent=2))
        return 0 if not errors else 1
    if args.cmd == "show":
        print(json.dumps({"ok": not errors, "errors": errors, "global": glob,
                          "repos": repos, "workspaces": workspaces}, ensure_ascii=False, indent=2))
        return 0 if not errors else 1
    if args.cmd == "workspace":
        if args.name:
            w = next((x for x in workspaces if x["name"] == args.name), None)
        else:
            w = find_by_dir(workspaces, args.dir or os.getcwd())
        if not w:
            print(json.dumps({"ok": False, "errors": ["workspace not found"]}))
            return 1
        print(json.dumps(w, ensure_ascii=False, indent=2))
        return 0
    if args.cmd == "repo":
        if args.repo:
            r = next((x for x in repos if x["repo"] == args.repo.lower()), None)
        else:
            r = find_by_dir(repos, args.dir or os.getcwd())
        if not r:
            print(json.dumps({"ok": False, "errors": ["repo not found"]}))
            return 1
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return 0


if __name__ == "__main__":
    sys.exit(main())
