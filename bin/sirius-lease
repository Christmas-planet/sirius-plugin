#!/usr/bin/env python3
"""Machine-wide, scope-aware run lease for Sirius.

  sirius-lease acquire <run-id> [--pid PID] [--scope SCOPE]   exit 0 when acquired, 3 when held by a live run
  sirius-lease heartbeat <run-id> [--scope SCOPE]
  sirius-lease release <run-id> [--scope SCOPE]
  sirius-lease status [--scope SCOPE]

Every read-check-write of the owner file happens under an exclusive flock, so two
runs can never both acquire the same scope, including while taking over an
abandoned lease.

Without --pid, liveness is judged only by heartbeat age: a Bash tool call's shell
exits right away, so its pid says nothing about whether the run is alive.
Heartbeat after every phase and at least every 15 minutes during long work; a lease
with no heartbeat for 2 hours is treated as abandoned.

Scopes let independent repos run in parallel while still serializing anything
machine-wide that must not overlap (e.g. LINE intake, which drives a single
Computer Use session against the phone/desktop app). Each scope gets its own
lock file under locks/, named after the scope with unsafe characters replaced.
With no --scope, the scope is "run" (the whole-run lease, unchanged from v0.2).
Typical scopes: "run" (the coordinator), "repo:<owner/repo>" (one repo's work),
"line" (LINE intake, global). The lease is local to this machine per scope. It
cannot stop a cloud routine that runs the same queue, so configure only one
scheduler per queue (config.yaml `scheduler`).
"""

import contextlib
import fcntl
import json
import os
import re
import sys
import time
from pathlib import Path

HOME = Path(os.environ.get("SIRIUS_HOME", Path.home() / ".sirius"))
LOCKS = HOME / "locks"
STALE_SECONDS = int(os.environ.get("SIRIUS_LEASE_STALE_SECONDS", 2 * 3600))


def scope_paths(scope):
    safe = re.sub(r"[^A-Za-z0-9_.-]+", "--", scope) or "run"
    return LOCKS / f"{safe}.owner.json", LOCKS / f"{safe}.mutex"


@contextlib.contextmanager
def exclusive(mutex_path):
    LOCKS.mkdir(parents=True, exist_ok=True)
    with open(mutex_path, "a") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


def read(owner_path):
    try:
        return json.loads(owner_path.read_text())
    except (OSError, ValueError):
        return None


def write(owner_path, owner):
    tmp = owner_path.with_suffix(f".tmp.{os.getpid()}")
    tmp.write_text(json.dumps(owner))
    os.replace(tmp, owner_path)


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def stale(owner):
    if owner is None:
        return True
    if owner.get("pid") and not alive(owner["pid"]):
        return True
    return time.time() - owner.get("heartbeat", 0) > STALE_SECONDS


def extract_flag(argv, flag):
    if flag in argv:
        idx = argv.index(flag)
        if idx + 1 >= len(argv):
            return None
        value = argv[idx + 1]
        del argv[idx:idx + 2]
        return value
    return None


def main(argv):
    argv = list(argv)
    scope = extract_flag(argv, "--scope") or "run"
    pid_flag = extract_flag(argv, "--pid")

    if not argv or argv[0] not in {"acquire", "heartbeat", "release", "status"}:
        print(__doc__, file=sys.stderr)
        return 64
    cmd = argv[0]
    owner_path, mutex_path = scope_paths(scope)
    with exclusive(mutex_path):
        owner = read(owner_path)
        if cmd == "status":
            print(json.dumps({"scope": scope, "held": owner is not None, "owner": owner,
                              "stale": owner is not None and stale(owner)}))
            return 0
        if len(argv) < 2:
            print(__doc__, file=sys.stderr)
            return 64
        run_id = argv[1]
        if cmd == "acquire":
            if owner is not None and not stale(owner):
                print(json.dumps({"acquired": False, "held_by": owner}))
                return 3
            if owner is not None:
                print(json.dumps({"recovered_stale": owner}), file=sys.stderr)
            pid = int(pid_flag) if pid_flag is not None else None
            now = time.time()
            write(owner_path, {"run_id": run_id, "scope": scope, "pid": pid, "started": now, "heartbeat": now})
            print(json.dumps({"acquired": True, "run_id": run_id, "scope": scope}))
            return 0
        if not owner or owner.get("run_id") != run_id:
            print(json.dumps({"ok": False, "reason": "lease not held by this run", "owner": owner}))
            return 1
        if cmd == "heartbeat":
            owner["heartbeat"] = time.time()
            write(owner_path, owner)
            return 0
        owner_path.unlink()
        print(json.dumps({"released": run_id, "scope": scope}))
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
