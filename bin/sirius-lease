#!/usr/bin/env python3
"""Machine-wide run lease for Sirius.

  sirius-lease acquire <run-id> [--pid PID]   exit 0 when acquired, 3 when held by a live run
  sirius-lease heartbeat <run-id>
  sirius-lease release <run-id>
  sirius-lease status

Without --pid, liveness is judged only by heartbeat age: a Bash tool call's shell
exits right away, so its pid says nothing about whether the run is alive.
Heartbeat after every phase.

The lease is local to this machine. It cannot stop a cloud routine that runs the
same queue, so configure only one scheduler per queue (config.yaml `scheduler`).
"""

import json
import os
import sys
import time
from pathlib import Path

HOME = Path(os.environ.get("SIRIUS_HOME", Path.home() / ".sirius"))
LOCK = HOME / "locks" / "run.lock"
STALE_SECONDS = int(os.environ.get("SIRIUS_LEASE_STALE_SECONDS", 45 * 60))


def read():
    try:
        return json.loads((LOCK / "owner.json").read_text())
    except (OSError, ValueError):
        return None


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def stale(owner):
    if owner is None:
        return True
    if owner.get("pid") and not alive(owner["pid"]):
        return True
    return time.time() - owner.get("heartbeat", 0) > STALE_SECONDS


def write(run_id, pid):
    (LOCK / "owner.json").write_text(json.dumps(
        {"run_id": run_id, "pid": pid, "started": time.time(), "heartbeat": time.time()}))


def acquire(run_id, pid):
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    try:
        LOCK.mkdir()
    except FileExistsError:
        owner = read()
        if not stale(owner):
            print(json.dumps({"acquired": False, "held_by": owner}))
            return 3
        # Take over a stale lease atomically: rename away, then retry once.
        grave = LOCK.with_name(f"run.lock.stale.{int(time.time())}")
        try:
            LOCK.rename(grave)
        except OSError:
            print(json.dumps({"acquired": False, "reason": "lost race on stale lease"}))
            return 3
        try:
            LOCK.mkdir()
        except FileExistsError:
            print(json.dumps({"acquired": False, "reason": "lost race on stale lease"}))
            return 3
        print(json.dumps({"recovered_stale": owner}), file=sys.stderr)
    write(run_id, pid)
    print(json.dumps({"acquired": True, "run_id": run_id}))
    return 0


def main(argv):
    if not argv:
        print(__doc__, file=sys.stderr)
        return 64
    cmd = argv[0]
    if cmd == "status":
        owner = read()
        print(json.dumps({"held": LOCK.exists(), "owner": owner,
                          "stale": LOCK.exists() and stale(owner)}))
        return 0
    if len(argv) < 2:
        print(__doc__, file=sys.stderr)
        return 64
    run_id = argv[1]
    if cmd == "acquire":
        pid = int(argv[argv.index("--pid") + 1]) if "--pid" in argv else None
        return acquire(run_id, pid)
    owner = read()
    if not owner or owner.get("run_id") != run_id:
        print(json.dumps({"ok": False, "reason": "lease not held by this run", "owner": owner}))
        return 1
    if cmd == "heartbeat":
        owner["heartbeat"] = time.time()
        (LOCK / "owner.json").write_text(json.dumps(owner))
        return 0
    if cmd == "release":
        (LOCK / "owner.json").unlink(missing_ok=True)
        LOCK.rmdir()
        print(json.dumps({"released": run_id}))
        return 0
    print(__doc__, file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
