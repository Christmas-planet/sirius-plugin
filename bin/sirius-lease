#!/usr/bin/env python3
"""Machine-wide run lease for Sirius.

  sirius-lease acquire <run-id> [--pid PID]   exit 0 when acquired, 3 when held by a live run
  sirius-lease heartbeat <run-id>
  sirius-lease release <run-id>
  sirius-lease status

Every read-check-write of the owner file happens under an exclusive flock, so two
runs can never both acquire, including while taking over an abandoned lease.

Without --pid, liveness is judged only by heartbeat age: a Bash tool call's shell
exits right away, so its pid says nothing about whether the run is alive.
Heartbeat after every phase and at least every 15 minutes during long work; a lease
with no heartbeat for 2 hours is treated as abandoned.

The lease is local to this machine. It cannot stop a cloud routine that runs the
same queue, so configure only one scheduler per queue (config.yaml `scheduler`).
"""

import contextlib
import fcntl
import json
import os
import sys
import time
from pathlib import Path

HOME = Path(os.environ.get("SIRIUS_HOME", Path.home() / ".sirius"))
LOCKS = HOME / "locks"
OWNER = LOCKS / "run.owner.json"
MUTEX = LOCKS / "run.mutex"
STALE_SECONDS = int(os.environ.get("SIRIUS_LEASE_STALE_SECONDS", 2 * 3600))


@contextlib.contextmanager
def exclusive():
    LOCKS.mkdir(parents=True, exist_ok=True)
    with open(MUTEX, "a") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


def read():
    try:
        return json.loads(OWNER.read_text())
    except (OSError, ValueError):
        return None


def write(owner):
    tmp = OWNER.with_suffix(f".tmp.{os.getpid()}")
    tmp.write_text(json.dumps(owner))
    os.replace(tmp, OWNER)


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def stale(owner):
    if owner is None:
        return True
    if owner.get("pid") and not alive(owner["pid"]):
        return True
    return time.time() - owner.get("heartbeat", 0) > STALE_SECONDS


def main(argv):
    if not argv or argv[0] not in {"acquire", "heartbeat", "release", "status"}:
        print(__doc__, file=sys.stderr)
        return 64
    cmd = argv[0]
    with exclusive():
        owner = read()
        if cmd == "status":
            print(json.dumps({"held": owner is not None, "owner": owner,
                              "stale": owner is not None and stale(owner)}))
            return 0
        if len(argv) < 2:
            print(__doc__, file=sys.stderr)
            return 64
        run_id = argv[1]
        if cmd == "acquire":
            if owner is not None and not stale(owner):
                print(json.dumps({"acquired": False, "held_by": owner}))
                return 3
            if owner is not None:
                print(json.dumps({"recovered_stale": owner}), file=sys.stderr)
            pid = int(argv[argv.index("--pid") + 1]) if "--pid" in argv else None
            now = time.time()
            write({"run_id": run_id, "pid": pid, "started": now, "heartbeat": now})
            print(json.dumps({"acquired": True, "run_id": run_id}))
            return 0
        if not owner or owner.get("run_id") != run_id:
            print(json.dumps({"ok": False, "reason": "lease not held by this run", "owner": owner}))
            return 1
        if cmd == "heartbeat":
            owner["heartbeat"] = time.time()
            write(owner)
            return 0
        OWNER.unlink()
        print(json.dumps({"released": run_id}))
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
